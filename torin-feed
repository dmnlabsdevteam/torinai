#!/usr/bin/env python3
"""One JSON snapshot of every channel, for the desktop app.

The app shells out to this rather than reimplementing anything: the channel
routing table and the raw_event query were both verified against live data, and
a Swift copy of either would be a second opinion to keep in sync. This is a thin
adapter over torin-dash's own readers, so there is still one implementation.
"""
import asyncio, importlib.machinery, importlib.util, json, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
_spec = importlib.util.spec_from_loader(
    "torin_dash", importlib.machinery.SourceFileLoader("torin_dash", str(HERE / "torin-dash")))
dash = importlib.util.module_from_spec(_spec)
sys.modules["torin_dash"] = dash
_spec.loader.exec_module(dash)

LIMIT = 200

#: A single record can be an entire stats dict -- health assessments log several
#: KB of JSON on one line. Untrimmed, one of those fills a pane and pushes every
#: other record off screen. The cut is declared, never silent.
MAX_MESSAGE = 320


def clamp(text):
    text = " ".join(text.split())          # collapse embedded newlines/indent
    if len(text) <= MAX_MESSAGE:
        return text
    return text[:MAX_MESSAGE] + f" … +{len(text) - MAX_MESSAGE} chars"


def parse(line):
    """`HH:MM:SS LEVEL   logger | message` -> fields, without guessing."""
    parts = line.split(None, 2)
    if len(parts) < 3:
        return {"time": "", "level": "", "source": "", "message": line}
    time, level, rest = parts
    source, _, message = rest.partition(" | ")
    if not message:
        source, message = "", rest
    return {"time": time, "level": level,
            "source": source.replace("core.", "", 1), "message": clamp(message)}


async def main():
    out, error = {}, None

    # From the routing authority, not a hardcoded list. This was
    # ("tasks", "security", "system") and silently ignored the 2026-08-25
    # channel change (tasks folded into substrate, health split out), so the
    # panels showed the old set. SUBSTRATE is handled separately below via
    # SubstrateFeed, so exclude it here.
    file_channels = [c for c in dash.ALL_CHANNELS if c != "substrate"]
    for name in file_channels:
        tail = dash.Tail(dash.CHANNEL_DIR / f"{name}.log", keep=LIMIT, channel=name)
        tail.poll()
        out[name] = {
            "origin": "torin_main.log" if tail.from_history else "live",
            "entries": [parse(l) for l in list(tail.lines)[-LIMIT:]],
        }

    feed = dash.SubstrateFeed(keep=LIMIT)
    await feed.connect()
    await feed.poll()
    if feed.error:
        error = feed.error
    entries = []
    for when, raw in list(feed.lines)[-LIMIT:]:
        event = json.loads(raw) if isinstance(raw, str) else (raw or {})
        fields = [f"{k}={event[k]}" for k in dash.SubstrateFeed.SALIENT
                  if event.get(k) is not None]
        entries.append({"time": when.strftime("%H:%M:%S"), "level": "",
                        "source": str(event.get("event", "unnamed")),
                        "message": clamp("  ".join(fields)), "event": True})
    out["substrate"] = {"origin": "recorded", "entries": entries}
    if feed.conn is not None:
        await feed.conn.close()

    if error:
        out["error"] = error
    json.dump(out, sys.stdout)


if __name__ == "__main__":
    asyncio.run(main())
