#!/bin/bash
#
# TorinAI Stop Script
# Gracefully stops the TorinAI system
#

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
LOGS_DIR="$SCRIPT_DIR/logs"
PID_DIR="$RUNTIME_DIR"

# PID files
MAIN_PID_FILE="$PID_DIR/torin_main.pid"

echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${RED} Stopping TorinAI${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Function to stop a process
stop_process() {
    local PID_FILE=$1
    local NAME=$2

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        echo -e "${YELLOW}Stopping $NAME (PID: $PID)...${NC}"

        if ps -p "$PID" > /dev/null 2>&1; then
            # Try graceful shutdown first
            kill "$PID" 2>/dev/null || true

            # Wait up to 10 seconds for graceful shutdown
            for i in {1..10}; do
                if ! ps -p "$PID" > /dev/null 2>&1; then
                    echo -e "${GREEN}✓ $NAME stopped gracefully${NC}"
                    rm -f "$PID_FILE"
                    return 0
                fi
                sleep 1
            done

            # Force kill if still running
            if ps -p "$PID" > /dev/null 2>&1; then
                echo -e "${ORANGE}⚠️  Forcing shutdown of $NAME...${NC}"
                kill -9 "$PID" 2>/dev/null || true
                sleep 1
            fi

            if ! ps -p "$PID" > /dev/null 2>&1; then
                echo -e "${GREEN}✓ $NAME stopped${NC}"
                rm -f "$PID_FILE"
                return 0
            else
                echo -e "${RED}❌ Failed to stop $NAME${NC}"
                return 1
            fi
        else
            echo -e "${YELLOW}Process not running, removing stale PID file${NC}"
            rm -f "$PID_FILE"
            return 0
        fi
    else
        echo -e "${BLUE}$NAME is not running (no PID file)${NC}"
        return 0
    fi
}

# Stop main system
stop_process "$MAIN_PID_FILE" "Main TorinAI System"

# Kill any remaining Python processes running TorinAI
echo ""
echo -e "${YELLOW}Checking for remaining TorinAI processes...${NC}"

# Find all Python processes with 'torin' or 'core/main.py' in command line
REMAINING_PIDS=$(ps aux | grep -i "[p]ython.*torin\|[p]ython.*core/main.py" | awk '{print $2}' || true)

if [ -n "$REMAINING_PIDS" ]; then
    echo -e "${ORANGE}Found remaining processes, cleaning up...${NC}"
    for PID in $REMAINING_PIDS; do
        echo -e "${YELLOW}  Killing process $PID...${NC}"
        kill -9 "$PID" 2>/dev/null || true
    done
    sleep 1
    echo -e "${GREEN}✓ Cleanup complete${NC}"
else
    echo -e "${GREEN}✓ No remaining processes found${NC}"
fi

# Kill processes on TorinAI server ports
echo ""
echo -e "${YELLOW}Checking TorinAI server ports...${NC}"

# Port 9080 - Chat Server
PORT_9080_PID=$(lsof -ti :9080 2>/dev/null || true)
if [ -n "$PORT_9080_PID" ]; then
    echo -e "${YELLOW}  Killing process on port 9080 (Chat Server): $PORT_9080_PID${NC}"
    kill -9 "$PORT_9080_PID" 2>/dev/null || true
    echo -e "${GREEN}✓ Port 9080 freed${NC}"
else
    echo -e "${GREEN}✓ Port 9080 is free${NC}"
fi

# Port 9001 - External API Server
PORT_9001_PID=$(lsof -ti :9001 2>/dev/null || true)
if [ -n "$PORT_9001_PID" ]; then
    echo -e "${YELLOW}  Killing process on port 9001 (External API): $PORT_9001_PID${NC}"
    kill -9 "$PORT_9001_PID" 2>/dev/null || true
    echo -e "${GREEN}✓ Port 9001 freed${NC}"
else
    echo -e "${GREEN}✓ Port 9001 is free${NC}"
fi

# Clean up runtime files
echo ""
echo -e "${YELLOW}Cleaning up runtime files...${NC}"
rm -f "$RUNTIME_DIR"/*.pid 2>/dev/null || true
rm -f "$RUNTIME_DIR"/*.sock 2>/dev/null || true
echo -e "${GREEN}✓ Runtime cleanup complete${NC}"

# Verify everything is stopped
echo ""
STILL_RUNNING=$(ps aux | grep -i "[p]ython.*torin\|[p]ython.*core/main.py" | wc -l || echo "0")
if [ "$STILL_RUNNING" -gt 0 ]; then
    echo -e "${RED}⚠️  Warning: Some TorinAI processes may still be running${NC}"
    echo -e "${YELLOW}Run 'ps aux | grep python | grep torin' to check${NC}"
else
    echo -e "${GREEN}✓ All TorinAI processes stopped${NC}"
fi

# ============================================================================
# MySQL Connection Cleanup
# ============================================================================
echo ""
echo -e "${YELLOW}Cleaning up MySQL connections...${NC}"

# Get MySQL password from .env.production (use single quotes to prevent ! expansion)
MYSQL_PASSWORD=""
if [ -f "$SCRIPT_DIR/.env.production" ]; then
    MYSQL_PASSWORD=$(grep "^MYSQL_PASSWORD=" "$SCRIPT_DIR/.env.production" | cut -d'=' -f2)
elif [ -f "$SCRIPT_DIR/.env" ]; then
    MYSQL_PASSWORD=$(grep "^MYSQL_PASSWORD=" "$SCRIPT_DIR/.env" | cut -d'=' -f2)
fi

if command -v mysql &> /dev/null && [ -n "$MYSQL_PASSWORD" ]; then
    # Use python to avoid bash ! escaping issues with the password
    STALE_COUNT=$("$SCRIPT_DIR/venv_torin/bin/python3" -c "
import subprocess, sys
result = subprocess.run(
    ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost',
     '--batch', '--skip-column-names', '-e',
     \"SELECT COUNT(*) FROM information_schema.processlist WHERE command = 'Sleep' AND time > 5;\"],
    capture_output=True, text=True
)
print(result.stdout.strip() if result.returncode == 0 else '0')
" 2>/dev/null || echo "0")

    if [ "$STALE_COUNT" -gt 0 ] 2>/dev/null; then
        echo -e "${ORANGE}  Found $STALE_COUNT stale MySQL connections${NC}"

        # Kill stale sleeping connections via python (avoids bash escaping issues)
        "$SCRIPT_DIR/venv_torin/bin/python3" -c "
import subprocess
# Get stale connection IDs
result = subprocess.run(
    ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost',
     '--batch', '--skip-column-names', '-e',
     \"SELECT id FROM information_schema.processlist WHERE command = 'Sleep' AND time > 5;\"],
    capture_output=True, text=True
)
ids = [i.strip() for i in result.stdout.strip().split('\n') if i.strip()]
if ids:
    kill_sql = '; '.join(f'KILL {cid}' for cid in ids)
    subprocess.run(
        ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost', '-e', kill_sql],
        capture_output=True, text=True
    )
    print(f'  Killed {len(ids)} stale connections')
" 2>/dev/null

        echo -e "${GREEN}✓ MySQL connections cleaned up${NC}"
    else
        echo -e "${GREEN}✓ No stale MySQL connections found${NC}"
    fi

    # Show final connection status
    FINAL_COUNT=$("$SCRIPT_DIR/venv_torin/bin/python3" -c "
import subprocess
result = subprocess.run(
    ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost',
     '--batch', '--skip-column-names', '-e',
     \"SHOW STATUS LIKE 'Threads_connected';\"],
    capture_output=True, text=True
)
if result.returncode == 0:
    parts = result.stdout.strip().split('\t')
    print(parts[-1] if parts else '?')
else:
    print('?')
" 2>/dev/null || echo "?")
    echo -e "${BLUE}  Active MySQL connections: $FINAL_COUNT${NC}"
else
    echo -e "${YELLOW}⚠  MySQL client not available or no password configured - skipping connection cleanup${NC}"
    echo -e "${GRAY}  Stale connections will be cleaned by MySQL wait_timeout${NC}"
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} TorinAI Stopped${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
