{
  "suite": "substrate_capability_v1",
  "description": "Benchmarks in the SUBSTRATE'S OWN TERMS. Every item here is answered by a deterministic engine the substrate owns -- Z3 for the equations, rule induction for the sequences -- with the model policy set to strict and zero model calls executed. The prose suite alongside this one measures the teacher: it asks questions the substrate cannot represent, so _substrate_first declines every one and the router escalates, and the model's answer is then recorded as the substrate's capability. Every shape in this file was verified answerable before it was written down; nothing aspirational is included, because a benchmark the substrate can never answer is a permanent zero that teaching cannot move and regression cannot fall below.",
  "tests": [
    {
      "test_id": "substrate_eq_001",
      "domain": "reasoning",
      "difficulty": "easy",
      "prompt": "Solve for x: 4x + 8 = 32",
      "expected_output": "x = 6",
      "evaluation_criteria": {
        "type": "exact_match"
      },
      "metadata": {
        "shape": "linear_equation",
        "answered_by": "constraint_solver (Z3)",
        "model_free": true
      }
    },
