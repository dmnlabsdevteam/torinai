    "RESOURCE_ALLOCATION": {
      "description": "Governance triggers for resource allocation changes",
      "cumulative_tracking": "System tracks aggregate changes over time windows to prevent death-by-a-thousand-cuts attacks",
      "reserved_margin_enforcement": "Over-capacity checks validate against usable capacity (total - reserved margins)",
      "triggers": [
        {
          "trigger_id": "resource_002",
          "name": "Resource Allocation Exceeds Capacity",
          "conditions": {
            "action_type": "allocate_resources",
            "parameters": {
              "exceeds_usable_capacity": true
            }
          },
          "escalation_category": "RESOURCE_ALLOCATION_OVER_CAPACITY",
          "irreversibility_class": "FULLY_REVERSIBLE",
          "impact_level": "HIGH",
          "safety_risk": "HIGH",
          "validation_mode": "PRE_GOVERNANCE",
          "rationale": "Allocating resources beyond usable capacity will cause system failures. Validated before governance."
        },
        {
          "trigger_id": "resource_003",
          "name": "Cumulative Resource Changes Exceed Threshold",
          "conditions": {
            "action_type": "allocate_resources",
            "parameters": {
              "cumulative_change_percent": {
                ">": 25
              },
              "time_window_hours": {
                "<=": 1
              }
            }
          },
          "escalation_category": "RESOURCE_CUMULATIVE_CHANGE",
          "irreversibility_class": "FULLY_REVERSIBLE",
          "impact_level": "HIGH",
          "safety_risk": "HIGH",
          "rationale": "Cumulative changes exceeding 25% in 1 hour prevent death-by-a-thousand-cuts resource exhaustion"
        },
        {
          "trigger_id": "resource_004",
          "name": "Resource Allocation Oscillation Detected",
          "conditions": {
            "action_type": "allocate_resources",
            "parameters": {
              "change_count_in_window": {
                ">": 3
              },
              "time_window_minutes": {
                "<=": 5
              }
            }
          },
          "escalation_category": "RESOURCE_OSCILLATION",
          "irreversibility_class": "FULLY_REVERSIBLE",
          "impact_level": "MEDIUM",
          "safety_risk": "MODERATE",
          "cooldown_period_minutes": 10,
          "rationale": "Rapid oscillating changes (>3 in 5 min) indicate instability or attack. Requires cooldown."
        },
        {
          "trigger_id": "resource_001",
          "name": "Large Resource Allocation Change",
          "conditions": {
            "action_type": "allocate_resources",
            "parameters": {
              "percent_change": {
                ">=": 25
              }
            }
          },
          "escalation_category": "RESOURCE_ALLOCATION_LARGE_CHANGE",
          "irreversibility_class": "FULLY_REVERSIBLE",
          "impact_level": "MEDIUM",
          "safety_risk": "MODERATE",
          "rationale": "Large resource allocation changes (>=25%) can affect system performance and stability"
        }
      ]
    },
    "LEARNING_PARAMETERS": {
      "description": "Governance triggers for learning system parameter changes (RISK-BASED)",
      "risk_based_enforcement": "Learning changes use magnitude-based risk tiers: LOW (<1%/5% no governance), MEDIUM (1-10%/5-25% AI judges allowed), HIGH (10-25% human preferred), CRITICAL (>25% or safety params human-only with crypto signature)",
      "learner_self_approval_blocked": "Learner CANNOT approve its own config changes regardless of risk tier (prevents direct self-modification)",
      "expiration_enforcement": "All approved changes expire after 90 days using trusted monotonic time source",
      "atomic_reversion": "Configuration reversion on expiration is atomic (no partial config states)",
      "triggers": [
        {
          "trigger_id": "learning_002",
          "name": "Large Learning Rate Change",
          "conditions": {
            "action_type": "update_learning_parameters",
