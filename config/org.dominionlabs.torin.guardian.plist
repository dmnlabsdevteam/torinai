<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.dominionlabs.torin.guardian</string>

    <!-- The guardian IS the always-on layer: monitoring and security that must
         outlive the substrate. launchd keeps it alive across crashes and reboots,
         which is what makes "daemon" true rather than "a script someone ran". -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/stefan/Dominion Labs/TorinAI/torin-guardian</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/stefan/Dominion Labs/TorinAI</string>

    <!-- Start at load and keep running; relaunch if it ever exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not thrash if it fails to start; wait 10s between relaunches. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/stefan/Dominion Labs/TorinAI/logs/guardian.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stefan/Dominion Labs/TorinAI/logs/guardian.log</string>
</dict>
</plist>
