#!/bin/bash
#
# TorinAI Kill Script
# Forcefully kills the TorinAI system (use only if ./torin-stop fails)
#

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
PID_DIR="$RUNTIME_DIR"

# PID files
MAIN_PID_FILE="$PID_DIR/torin_main.pid"

echo ""
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${RED} Force Killing TorinAI${NC}"
echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Function to force kill a process
kill_process() {
    local PID_FILE=$1
    local NAME=$2

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        echo -e "${RED}Force killing $NAME (PID: $PID)...${NC}"

        if ps -p "$PID" > /dev/null 2>&1; then
            kill -9 "$PID" 2>/dev/null || true
            sleep 1

            if ! ps -p "$PID" > /dev/null 2>&1; then
                echo -e "${GREEN}✓ $NAME killed${NC}"
                rm -f "$PID_FILE"
                return 0
            else
                echo -e "${RED}❌ Failed to kill $NAME${NC}"
                return 1
            fi
        else
            echo -e "${YELLOW}Process not running, removing stale PID file${NC}"
            rm -f "$PID_FILE"
            return 0
        fi
    else
        echo -e "${BLUE}$NAME is not running (no PID file)${NC}"
        return 0
    fi
}

# Kill main system
kill_process "$MAIN_PID_FILE" "Main TorinAI System"

# Also kill any python processes running main.py
echo -e "${YELLOW}Searching for remaining TorinAI processes...${NC}"
REMAINING=$(pgrep -f "python3.*core/main.py" || true)
if [ ! -z "$REMAINING" ]; then
    echo -e "${ORANGE}Found remaining processes: $REMAINING${NC}"
    pkill -9 -f "python3.*core/main.py" 2>/dev/null || true
    echo -e "${GREEN}✓ Killed remaining processes${NC}"
else
    echo -e "${GREEN}✓ No remaining processes found${NC}"
fi

# Clean up runtime files
rm -f "$RUNTIME_DIR"/*.pid 2>/dev/null || true
rm -f "$RUNTIME_DIR"/*.sock 2>/dev/null || true

# ============================================================================
# MySQL Connection Cleanup (force kill leaves connections orphaned)
# ============================================================================
echo ""
echo -e "${YELLOW}Cleaning up orphaned MySQL connections...${NC}"

MYSQL_PASSWORD=""
if [ -f "$SCRIPT_DIR/.env.production" ]; then
    MYSQL_PASSWORD=$(grep "^MYSQL_PASSWORD=" "$SCRIPT_DIR/.env.production" | cut -d'=' -f2)
elif [ -f "$SCRIPT_DIR/.env" ]; then
    MYSQL_PASSWORD=$(grep "^MYSQL_PASSWORD=" "$SCRIPT_DIR/.env" | cut -d'=' -f2)
fi

if command -v mysql &> /dev/null && [ -n "$MYSQL_PASSWORD" ]; then
    PYTHON_BIN="$SCRIPT_DIR/venv_torin/bin/python3"
    [ ! -f "$PYTHON_BIN" ] && PYTHON_BIN="python3"

    "$PYTHON_BIN" -c "
import subprocess
# Get ALL sleeping connection IDs (force kill = all are orphaned)
result = subprocess.run(
    ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost',
     '--batch', '--skip-column-names', '-e',
     \"SELECT id FROM information_schema.processlist WHERE command = 'Sleep';\"],
    capture_output=True, text=True
)
ids = [i.strip() for i in result.stdout.strip().split('\n') if i.strip()]
if ids:
    kill_sql = '; '.join(f'KILL {cid}' for cid in ids)
    subprocess.run(
        ['mysql', '-u', 'root', '-p$MYSQL_PASSWORD', '-h', 'localhost', '-e', kill_sql],
        capture_output=True, text=True
    )
    print(f'  Killed {len(ids)} orphaned MySQL connections')
else:
    print('  No orphaned connections found')
" 2>/dev/null
    echo -e "${GREEN}✓ MySQL cleanup complete${NC}"
else
    echo -e "${YELLOW}⚠  Skipping MySQL cleanup (no client or password)${NC}"
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} TorinAI Force Killed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
