conda-env/
.conda/.env

# ===== Added 2026-08-29: gaps that let the venv/secrets/build get committed =====
# The project virtualenv is named venv_torin (the generic `venv/` above missed it)
venv_torin/
# CPython source + tarball used to build the venv — never source-control these
Python-3.11.4/
Python-3.11.4.tgz
# SECRETS — must never be committed
.encryption_key
*.key
*.pem
# Shell history / session state captured under the sandbox shell
.torinshell/
# Database dumps (data + potentially sensitive)
backups/
*.dump
*.sql.gz
# Bulky vendored / third-party trees
third_party/
wasmtime/
alphafold/
# Large corpora / papers (add specific files explicitly if any are needed)
research_papers/
data/training/

# Deployment/self-improvement artifacts (bulky, regenerated)
data/deployment_backups/

