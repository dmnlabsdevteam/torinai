ORANGE='\033[38;5;208m'     # Bright orange
GRAY='\033[38;5;240m'       # Dark gray
NC='\033[0m'                # No color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
LOGS_DIR="$SCRIPT_DIR/logs"
PID_DIR="$RUNTIME_DIR"

# Create necessary directories
mkdir -p "$RUNTIME_DIR"
mkdir -p "$LOGS_DIR"

# PID files
MAIN_PID_FILE="$PID_DIR/torin_main.pid"

# Log files
MAIN_LOG_FILE="$LOGS_DIR/torin_main.log"

# Banner
echo ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}                                                                ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}      ${ORANGE}████████╗ ██████╗ ██████╗ ██╗███╗   ██╗ █████╗ ██╗${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}      ${ORANGE}╚══██╔══╝██╔═══██╗██╔══██╗██║████╗  ██║██╔══██╗██║${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}         ${ORANGE}██║   ██║   ██║██████╔╝██║██╔██╗ ██║███████║██║${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}         ${ORANGE}██║   ██║   ██║██╔══██╗██║██║╚██╗██║██╔══██║██║${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}         ${ORANGE}██║   ╚██████╔╝██║  ██║██║██║ ╚████║██║  ██║██║${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}         ${ORANGE}╚═╝    ╚═════╝ ╚═╝  ╚═╝╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝${NC}        ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}                                                                ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}              ${BLUE}Autonomous AI System - Full Ecosystem${NC}             ${CYAN}║${NC}"
echo -e "${CYAN}║${NC}                                                                ${CYAN}║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
