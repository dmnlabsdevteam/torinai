#!/bin/bash
#
# TorinAI Status Script
# Shows status of TorinAI system
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Directories
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RUNTIME_DIR="$SCRIPT_DIR/runtime"
LOGS_DIR="$SCRIPT_DIR/logs"
PID_DIR="$RUNTIME_DIR"

# PID files
MAIN_PID_FILE="$PID_DIR/torin_main.pid"

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN} TorinAI System Status${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Function to check process status
check_process_status() {
    local PID_FILE=$1
    local NAME=$2

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        echo -e "${BLUE}$NAME:${NC}"
        echo -e "  PID File: $PID_FILE"
        echo -e "  PID: $PID"

        if ps -p "$PID" > /dev/null 2>&1; then
            echo -e "  Status: ${GREEN}RUNNING ✓${NC}"

            # Get process info
            CPU=$(ps -p "$PID" -o %cpu= 2>/dev/null | xargs)
            MEM=$(ps -p "$PID" -o %mem= 2>/dev/null | xargs)
            UPTIME=$(ps -p "$PID" -o etime= 2>/dev/null | xargs)

            echo -e "  CPU: ${CPU}%"
            echo -e "  Memory: ${MEM}%"
            echo -e "  Uptime: ${UPTIME}"
        else
            echo -e "  Status: ${RED}NOT RUNNING ✗${NC}"
            echo -e "  ${YELLOW}(Stale PID file - process not found)${NC}"
        fi
    else
        echo -e "${BLUE}$NAME:${NC}"
        echo -e "  Status: ${YELLOW}NOT RUNNING${NC}"
        echo -e "  ${YELLOW}(No PID file found)${NC}"
    fi
    echo ""
}

# Check main system
check_process_status "$MAIN_PID_FILE" "Main TorinAI System"

# Show log file info
echo -e "${BLUE}Log Files:${NC}"
MAIN_LOG="$LOGS_DIR/torin_main.log"
if [ -f "$MAIN_LOG" ]; then
    LOG_SIZE=$(du -h "$MAIN_LOG" | cut -f1)
    LOG_LINES=$(wc -l < "$MAIN_LOG")
    echo -e "  Main Log: ${GREEN}$MAIN_LOG${NC}"
    echo -e "  Size: $LOG_SIZE"
    echo -e "  Lines: $LOG_LINES"
    echo ""
    echo -e "${BLUE}Last 10 log entries:${NC}"
    tail -10 "$MAIN_LOG" 2>/dev/null || echo "  (Unable to read log file)"
else
    echo -e "  ${YELLOW}Main log file not found: $MAIN_LOG${NC}"
fi

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Exit with appropriate code
if [ -f "$MAIN_PID_FILE" ]; then
    PID=$(cat "$MAIN_PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
        exit 0  # Running
    else
        exit 1  # Stale PID
    fi
else
    exit 2  # Not running
fi
